# ============================================================================
# 密钥模板 —— 复制本文件为 .env，填入你自己的值
#   Windows：在项目根目录新建文件，文件名就叫 .env（注意要打开"显示文件扩展名"，
#            别弄成 .env.txt）
#   填完后运行 python scripts/check_env.py 自检
# ============================================================================

# ---------------------------------------------------------------------------
# 1) DeepSeek（必需 —— 除了纯 Python 课，几乎所有课都要）
#    申请：https://platform.deepseek.com/api_keys
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-在这里粘贴你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------------------------------------------------------------------------
# 2) 高德地图（day03 的天气接口用）
#    申请：https://console.amap.com  —— 必须选「Web服务」类型的 key
# ---------------------------------------------------------------------------
AMAP_KEY=在这里粘贴高德Web服务key

# ---------------------------------------------------------------------------
# 3) QQ 邮箱 SMTP（day03/11 智能体发邮件用）
#    获取：QQ邮箱 → 设置 → 账号 → 开启「POP3/SMTP服务」→ 生成【授权码】
#    注意：是授权码，不是 QQ 登录密码！
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的QQ号@qq.com
SMTP_AUTH_CODE=在这里粘贴16位授权码
MAIL_TO=你的QQ号@qq.com
